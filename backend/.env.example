SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=<chave anon do CLI>
SUPABASE_SERVICE_ROLE_KEY=<chave service do CLI>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:54322/postgres
R2_ACCOUNT_ID=<seu account id>
R2_ACCESS_KEY_ID=<sua access key>
R2_SECRET_ACCESS_KEY=<seu secret>
R2_BUCKET_NAME=docke-dev
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
ENABLE_OCR_WORKER=true
CORS_ORIGINS=http://localhost:5173
# Segredo de JWT do projeto Supabase (Settings > API). Em produção, nunca o
# valor padrão do `supabase start` — a API recusa subir com ele.
JWT_SECRET=<jwt secret do projeto>
# Senha da conta demo (demo@docke.app). Só em variável de ambiente/Fly secret.
DEMO_PASSWORD=<senha da conta demo>
